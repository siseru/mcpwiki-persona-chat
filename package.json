{
  "name": "mcpwiki-persona-chat",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siseru/mcpwiki-persona-chat.git"
  },
  "description": "MCPWiki extension: talk with LLM-played characters that live in wiki articles",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build": "npm run build:ts && npm run build:bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test build/test/*.test.js",
    "synth": "npm run build && cdk synth --quiet",
    "deploy:dev": "npm run build && cdk deploy PersonaChat-dev"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.272.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "typescript": "~7.0.2"
  }
}
